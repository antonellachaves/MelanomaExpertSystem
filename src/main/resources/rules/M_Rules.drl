
package rules

import model.Patient;
import model.MelanomaClassification;
import model.MCategory;
import model.LdhStatus;

// M_R01: No distant metastasis -> M0
rule "M_R01 - M0"
salience 8000
when
    $patient : Patient(
        $id : patientId,
        $distant : distantDisease
    )

    eval($distant != null
        && Boolean.FALSE.equals($distant.getDistantMetastasis())
        && !Boolean.TRUE.equals($distant.getDistantSkinSoftTissueNonregionalNode())
        && !Boolean.TRUE.equals($distant.getLungMetastasis())
        && !Boolean.TRUE.equals($distant.getNonCnsVisceralMetastasis())
        && !Boolean.TRUE.equals($distant.getCnsMetastasis()))

    $classification : MelanomaClassification(
        patientId == $id,
        mCategory == null
    )
then
    $classification.setMCategory(MCategory.M0);
    update($classification);
end

// M_R02: M1A - LDH not recorded
rule "M_R02 - M1A"
salience 8000
when
    $patient : Patient(
        $id : patientId,
        $distant : distantDisease
    )

    eval($distant != null
        && Boolean.TRUE.equals($distant.getDistantMetastasis())
        && Boolean.TRUE.equals($distant.getDistantSkinSoftTissueNonregionalNode())
        && Boolean.FALSE.equals($distant.getLungMetastasis())
        && Boolean.FALSE.equals($distant.getNonCnsVisceralMetastasis())
        && Boolean.FALSE.equals($distant.getCnsMetastasis())
        && $distant.getLdhStatus() == LdhStatus.NOT_RECORDED)

    $classification : MelanomaClassification(
        patientId == $id,
        mCategory == null
    )
then
    $classification.setMCategory(MCategory.M1A);
    update($classification);
end

// M_R03: M1A(0) - LDH not elevated
rule "M_R03 - M1A(0)"
salience 8000
when
    $patient : Patient(
        $id : patientId,
        $distant : distantDisease
    )

    eval($distant != null
        && Boolean.TRUE.equals($distant.getDistantMetastasis())
        && Boolean.TRUE.equals($distant.getDistantSkinSoftTissueNonregionalNode())
        && Boolean.FALSE.equals($distant.getLungMetastasis())
        && Boolean.FALSE.equals($distant.getNonCnsVisceralMetastasis())
        && Boolean.FALSE.equals($distant.getCnsMetastasis())
        && $distant.getLdhStatus() == LdhStatus.NOT_ELEVATED)

    $classification : MelanomaClassification(
        patientId == $id,
        mCategory == null
    )
then
    $classification.setMCategory(MCategory.M1A_0);
    update($classification);
end


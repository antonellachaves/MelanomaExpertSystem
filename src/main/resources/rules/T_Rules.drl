
package rules

import model.Patient;
import model.MelanomaClassification;
import model.TCategory;
import model.PrimaryTumorType;


// ======================================================
// T_R01: Breslow < 0.8 mm, no ulceration -> T1A
// ======================================================

rule "T_R01 - T1A"
salience 10000
when
    $patient : Patient(
        $id : patientId,
        $tumor : primaryTumor
    )

    eval($tumor != null &&
         $tumor.getType() == PrimaryTumorType.INVASIVE &&
         $tumor.getBreslowThicknessMm() != null &&
         $tumor.getBreslowThicknessMm() < 0.8 &&
         Boolean.FALSE.equals($tumor.getUlceration()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory == null
    )
then
    $classification.setTCategory(TCategory.T1A);
    update($classification);

    System.out.println("Patient " + $id + " -> T_R01 -> T1A");
end


// ======================================================
// T_R02: Breslow < 0.8 mm, ulceration -> T1B
// ======================================================


// ======================================================
// T_R03: Breslow 0.8-1.0 mm -> T1B
// Ulceration does not change the T category
// ======================================================

rule "T_R03 - T1B"
salience 10000
when
    $patient : Patient(
        $id : patientId,
        $tumor : primaryTumor
    )

    eval($tumor != null &&
         $tumor.getType() == PrimaryTumorType.INVASIVE &&
         $tumor.getBreslowThicknessMm() != null &&
         $tumor.getBreslowThicknessMm() >= 0.8 &&
         $tumor.getBreslowThicknessMm() <= 1.0)

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory == null
    )
then
    $classification.setTCategory(TCategory.T1B);
    update($classification);

    System.out.println("Patient " + $id + " -> T_R03 -> T1B");
end


// T_R04 removed because it is redundant with T_R03



// S_R11: T1A/T1B/T2A/T2B/T3A + N2C/N3A/N3B/N3C + M0
rule "S_R11 - Stage IIIC group 1"
salience 7000
when
    $patient : Patient($id : patientId)

    $classification : MelanomaClassification(
        patientId == $id,

        (tCategory == TCategory.T1A ||
         tCategory == TCategory.T1B ||
         tCategory == TCategory.T2A ||
         tCategory == TCategory.T2B ||
         tCategory == TCategory.T3A),

        (nCategory == NCategory.N2C ||
         nCategory == NCategory.N3A ||
         nCategory == NCategory.N3B ||
         nCategory == NCategory.N3C),

        mCategory == MCategory.M0,
        stage == null
    )
then
    $classification.setStage(MelanomaStage.IIIC);
    update($classification);

    System.out.println("Patient " + $id + " -> S_R11 -> Stage IIIC");
end


// S_R12: T3B/T4A + any N except N0 + M0 -> Stage IIIC
rule "S_R12 - Stage IIIC group 2"
salience 7000
when
    $patient : Patient($id : patientId)

    $classification : MelanomaClassification(
        patientId == $id,

        (tCategory == TCategory.T3B ||
         tCategory == TCategory.T4A),

        nCategory != null,
        nCategory != NCategory.N0,

        mCategory == MCategory.M0,
        stage == null
    )
then
    $classification.setStage(MelanomaStage.IIIC);
    update($classification);

    System.out.println("Patient " + $id + " -> S_R12 -> Stage IIIC");
end



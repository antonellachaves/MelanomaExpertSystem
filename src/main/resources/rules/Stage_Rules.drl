    $classification : MelanomaClassification(
        patientId == $id,
        tCategory == TCategory.T4B,

        (nCategory == NCategory.N1A ||
         nCategory == NCategory.N1B ||
         nCategory == NCategory.N1C ||
         nCategory == NCategory.N2A ||
         nCategory == NCategory.N2B ||
         nCategory == NCategory.N2C),

        mCategory == MCategory.M0,
        stage == null
    )
then
    $classification.setStage(MelanomaStage.IIIC);
    update($classification);

    System.out.println("Patient " + $id + " -> S_R13 -> Stage IIIC");
end



// S_R15: Any M1 category -> Stage IV
// T, N and M must all be available first.
rule "S_R15 - Stage IV"
salience 7000
when
    $patient : Patient($id : patientId)

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory != null,
        mCategory != null,
        mCategory != MCategory.M0,
        stage == null
    )
then
    $classification.setStage(MelanomaStage.IV);
    update($classification);

    System.out.println("Patient " + $id + " -> S_R15 -> Stage IV");
end



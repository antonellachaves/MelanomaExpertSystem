
package rules

import model.Patient;
import model.MelanomaClassification;
import model.TCategory;
import model.NCategory;
import model.MCategory;
import model.MelanomaStage;


// S_R01: T1A/T1B + N0 + M0 -> Stage IA
rule "S_R01 - Stage IA"
salience 7000
when
    $patient : Patient($id : patientId)

    $classification : MelanomaClassification(
        patientId == $id,
        (tCategory == TCategory.T1A ||
         tCategory == TCategory.T1B),
        nCategory == NCategory.N0,
        mCategory == MCategory.M0,
        stage == null
    )
then
    $classification.setStage(MelanomaStage.IA);
    update($classification);

    System.out.println("Patient " + $id + " -> S_R01 -> Stage IA");
end



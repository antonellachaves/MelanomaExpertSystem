
package rules

import model.Patient;
import model.ClinicalFinding;
import model.PrimaryTumorType;
import model.MelanomaClassification;
import model.MelanomaStage;
import model.SurgeryStatus;
import model.DiseaseStatus;
import model.SentinelNodeBiopsyStatus;


// INF-01: Identify regional nodal concern
rule "INF-01 - Identify regional nodal concern"
    salience 6000
when
    Patient(
        $id : patientId,
        $context : clinicalContext,
        $regional : regionalDisease
    )

    eval(
        ($context != null
         && Boolean.TRUE.equals(
             $context.getSuspiciousRegionalNode()
         ))
        ||
        ($regional != null
         && Boolean.TRUE.equals(
             $regional.getClinicallyDetectedNode()
         ))
    )

    not ClinicalFinding(
        patientId == $id,
        type == "SUSPECTED_NODAL_DISEASE"
    )
then
    insert(new ClinicalFinding(
        $id,
        "SUSPECTED_NODAL_DISEASE",
        "Regional nodal concern has been identified. "
        + "The clinical findings and any available "
        + "pathological confirmation must be reviewed.",
        "INF-01"
    ));

    System.out.println(
        "Patient " + $id
        + " -> INF-01: regional nodal concern"
    );
end


// INF-02: Identify clinically node-negative scenario
rule "INF-02 - Identify clinically node-negative patient"
    salience 6000
when
    Patient(
        $id : patientId,
        $context : clinicalContext,
        $regional : regionalDisease
    )

    eval(
        $context != null
        && $regional != null
        && Boolean.FALSE.equals(
            $context.getSuspiciousRegionalNode()
        )
        && Boolean.FALSE.equals(
            $regional.getClinicallyDetectedNode()
        )
    )

    not ClinicalFinding(
        patientId == $id,
        type == "CLINICALLY_NODE_NEGATIVE"
    )
then
    insert(new ClinicalFinding(
        $id,
        "CLINICALLY_NODE_NEGATIVE",
        "No suspicious or clinically detected "
        + "regional nodes are reported. This does "
        + "not establish a negative pathological "
        + "sentinel node biopsy result.",
        "INF-02"
    ));

    System.out.println(
        "Patient " + $id
        + " -> INF-02: clinically node-negative"
    );
end


// INF-03: Identify scenario for SLNB consideration
rule "INF-03 - Identify SLNB consideration criteria"
    salience 5900
when
    Patient(
        $id : patientId,
        $tumor : primaryTumor,
        $context : clinicalContext
    )

    eval(
        $tumor != null
        && $context != null
        && $tumor.getType() == PrimaryTumorType.INVASIVE
        && $tumor.getBreslowThicknessMm() != null
        && $tumor.getBreslowThicknessMm() >= 1.0
        && $context.getSentinelNodeBiopsyStatus()
            == SentinelNodeBiopsyStatus.NOT_PERFORMED
    )

    ClinicalFinding(
        patientId == $id,
        type == "CLINICALLY_NODE_NEGATIVE"
    )

    not ClinicalFinding(
        patientId == $id,
        type == "SLNB_CRITERIA_MET"
    )
then
    insert(new ClinicalFinding(
        $id,
        "SLNB_CRITERIA_MET",
        "The invasive melanoma has a Breslow "
        + "thickness of at least 1.0 mm, "
        + "no clinically suspicious regional nodes "
        + "are reported, and SLNB has not been "
        + "performed. Clinical eligibility and "
        + "appropriate management require review.",
        "INF-03"
    ));

    System.out.println(
        "Patient " + $id
        + " -> INF-03: SLNB consideration"
    );
end


// INF-04: Identify advanced staging assessment scenario
rule "INF-04 - Identify advanced staging assessment"
    salience 5900
when
    Patient(
        $id : patientId
    )

    MelanomaClassification(
        patientId == $id,
        stage in (
            MelanomaStage.IIB,
            MelanomaStage.IIC,
            MelanomaStage.IIIA,
            MelanomaStage.IIIB,
            MelanomaStage.IIIC,
            MelanomaStage.IIID,
            MelanomaStage.IV
        )
    )

    not ClinicalFinding(
        patientId == $id,
        type == "ADVANCED_STAGING_ASSESSMENT_NEEDED"
    )
then
    insert(new ClinicalFinding(
        $id,
        "ADVANCED_STAGING_ASSESSMENT_NEEDED",
        "The identified melanoma stage warrants "
        + "review of appropriate staging "
        + "investigations, considering previous "
        + "imaging and the clinical situation.",
        "INF-04"
    ));

    System.out.println(
        "Patient " + $id
        + " -> INF-04: staging assessment"
    );
end


// INF-05: Identify potential routine follow-up scenario
rule "INF-05 - Identify routine follow-up scenario"
    salience 5800
when
    Patient(
        $id : patientId,
        $context : clinicalContext,
        $regional : regionalDisease,
        $distant : distantDisease
    )

    eval(
        $context != null
        && $regional != null
        && $distant != null
        && $context.getSurgeryStatus()
            == SurgeryStatus.COMPLETE
        && $context.getDiseaseStatus()
            == DiseaseStatus.NO_EVIDENCE_OF_DISEASE
        && Boolean.FALSE.equals(
            $context.getNewSymptoms()
        )
        && Boolean.FALSE.equals(
            $context.getSuspiciousRegionalNode()
        )
        && Boolean.FALSE.equals(
            $context.getCurrentlyUnderTreatment()
        )
        && Boolean.FALSE.equals(
            $regional.getClinicallyDetectedNode()
        )
        && Boolean.FALSE.equals(
            $distant.getDistantMetastasis()
        )
    )

    not ClinicalFinding(
        patientId == $id,
        type == "SUSPECTED_NODAL_DISEASE"
    )

    not ClinicalFinding(
        patientId == $id,
        type == "ROUTINE_FOLLOW_UP_SCENARIO"
    )
then
    insert(new ClinicalFinding(
        $id,
        "ROUTINE_FOLLOW_UP_SCENARIO",
        "Surgery is complete, no current evidence "
        + "of disease or new concerning symptoms "
        + "is reported, and the patient is not "
        + "under active treatment. The appropriate "
        + "follow-up plan requires stage-specific "
        + "assessment.",
        "INF-05"
    ));

    System.out.println(
        "Patient " + $id
        + " -> INF-05: potential routine follow-up"
    );
end

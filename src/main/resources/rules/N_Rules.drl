
package rules

import model.Patient;
import model.MelanomaClassification;
import model.NCategory;

// N_R01: No regional lymph node or locoregional metastasis
rule "N_R01 - N0"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null
        && Integer.valueOf(0).equals($regional.getInvolvedRegionalNodes())
        && Boolean.FALSE.equals($regional.hasLocoregionalMetastasis())
        && Boolean.FALSE.equals($regional.getMattedNodes()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N0);
    update($classification);
end

// N_R02: One clinically occult node
rule "N_R02 - N1A"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null
        && Integer.valueOf(1).equals($regional.getInvolvedRegionalNodes())
        && Boolean.FALSE.equals($regional.getClinicallyDetectedNode())
        && Boolean.FALSE.equals($regional.hasLocoregionalMetastasis())
        && Boolean.FALSE.equals($regional.getMattedNodes()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N1A);
    update($classification);
end

// N_R03: One clinically detected node
rule "N_R03 - N1B"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null
        && Integer.valueOf(1).equals($regional.getInvolvedRegionalNodes())
        && Boolean.TRUE.equals($regional.getClinicallyDetectedNode())
        && Boolean.FALSE.equals($regional.hasLocoregionalMetastasis())
        && Boolean.FALSE.equals($regional.getMattedNodes()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N1B);
    update($classification);
end

// N_R04: No involved nodes, locoregional metastasis present
rule "N_R04 - N1C"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null
        && Integer.valueOf(0).equals($regional.getInvolvedRegionalNodes())
        && Boolean.TRUE.equals($regional.hasLocoregionalMetastasis())
        && Boolean.FALSE.equals($regional.getMattedNodes()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N1C);
    update($classification);
end

// N_R05: Two or three clinically occult nodes
rule "N_R05 - N2A"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null
        && $regional.getInvolvedRegionalNodes() != null
        && $regional.getInvolvedRegionalNodes() >= 2
        && $regional.getInvolvedRegionalNodes() <= 3
        && Boolean.FALSE.equals($regional.getClinicallyDetectedNode())
        && Boolean.FALSE.equals($regional.hasLocoregionalMetastasis())
        && Boolean.FALSE.equals($regional.getMattedNodes()))

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N2A);
    update($classification);
end


// N_R05: 2-3 clinically occult nodes -> N2A
rule "N_R05 - N2A"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null &&
         $regional.getInvolvedRegionalNodes() >= 2 &&
         $regional.getInvolvedRegionalNodes() <= 3 &&
         !$regional.isClinicallyDetectedNode() &&
         !$regional.hasLocoregionalMetastasis() &&
         !$regional.isMattedNodes())

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N2A);
    update($classification);

    System.out.println("Patient " + $id + " -> N_R05 -> N2A");
end



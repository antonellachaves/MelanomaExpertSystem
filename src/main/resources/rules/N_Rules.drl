
package rules

import model.Patient;
import model.RegionalDisease;
import model.MelanomaClassification;
import model.NCategory;


// N_R01: No regional nodes or locoregional metastasis -> N0
rule "N_R01 - N0"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null &&
         $regional.getInvolvedRegionalNodes() == 0 &&
         !$regional.isInTransitMetastasis() &&
         !$regional.isSatelliteMetastasis() &&
         !$regional.isMicrosatelliteMetastasis() &&
         !$regional.isMattedNodes())

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N0);
    update($classification);

    System.out.println("Patient " + $id + " -> N_R01 -> N0");
end


// N_R02: One clinically occult node -> N1A
rule "N_R02 - N1A"
salience 9000
when
    $patient : Patient(
        $id : patientId,
        $regional : regionalDisease
    )

    eval($regional != null &&
         $regional.getInvolvedRegionalNodes() == 1 &&
         !$regional.isClinicallyDetectedNode() &&
         !$regional.hasLocoregionalMetastasis() &&
         !$regional.isMattedNodes())

    $classification : MelanomaClassification(
        patientId == $id,
        tCategory != null,
        nCategory == null
    )
then
    $classification.setNCategory(NCategory.N1A);
    update($classification);

    System.out.println("Patient " + $id + " -> N_R02 -> N1A");
end


